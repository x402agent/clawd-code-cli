{
  "name": "clawd-tui",
  "version": "0.1.0",
  "description": "Open Clawd — a lobster-themed agent TUI built on @openrouter/agent",
  "type": "module",
  "bin": {
    "clawd-tui": "dist/cli.js",
    "clawd": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/cli.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/cli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agent",
    "tui",
    "openrouter",
    "cli",
    "clawd",
    "lobster"
  ],
  "license": "MIT",
  "dependencies": {
    "@openrouter/agent": "latest",
    "glob": "^10.3.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
